# Copia este archivo a .env y rellena los valores reales (nunca subas .env a git).

# Google Places API — para mostrar tu calificación y reseñas reales de Google.
# 1. Crea/usa un proyecto en https://console.cloud.google.com
# 2. Activa la "Places API (New)" y crea una API key.
# 3. Restringe la key por "API restrictions" a solo "Places API (New)". No le pongas restricción
#    de IP: se usa en el build de Vercel, cuya IP cambia en cada deploy.
# 4. Busca tu Place ID con https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Google Tag Manager — contenedor único para Google Analytics 4, Meta Pixel, etc.
# Se agrega dentro de Tag Manager, no aquí en el código. ID con forma GTM-XXXXXXX.
PUBLIC_GTM_ID=
