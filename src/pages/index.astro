---
import Menu from '../components/Menu.astro';
import Hero from '../components/Hero.astro';
import ItinerarySplit from '../components/ItinerarySplit.astro';
import Departures from '../components/Departures.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
import { trips, formatRange } from '../data/trips';

const site = (Astro.site ?? new URL('https://china.alalibreagency.com')).href;

const socials = [
	'https://www.instagram.com/alalibreagency',
	'https://www.facebook.com/alalibreagency',
	'https://www.tiktok.com/@alalibreagency',
];

const agency = {
	'@type': 'TravelAgency',
	'@id': `${site}#agency`,
	name: 'Ala Libre',
	url: site,
	logo: {
		'@type': 'ImageObject',
		url: new URL('/icon-512.png', site).href,
		width: 512,
		height: 512,
	},
	image: new URL('/og-image.jpg', site).href,
	email: 'alalibreagency@gmail.com',
	telephone: '+522211201356',
	address: {
		'@type': 'PostalAddress',
		streetAddress: '5 de Mayo 1004, 12 Oriente, Plaza La Joya',
		addressLocality: 'San Andrés Cholula',
		addressRegion: 'Puebla',
		postalCode: '72810',
		addressCountry: 'MX',
	},
	contactPoint: {
		'@type': 'ContactPoint',
		telephone: '+522211201356',
		email: 'alalibreagency@gmail.com',
		contactType: 'customer service',
		availableLanguage: ['Spanish'],
	},
	sameAs: socials,
};

const tripSchema = trips.map((trip) => {
	const priced = trip.departures.filter((d) => d.price !== undefined);
	const prices = priced.map((d) => d.price as number);
	const url = `${site}#${trip.slug}`;

	return {
		'@type': 'TouristTrip',
		'@id': url,
		name: `${trip.name}: viaje grupal a China, ${trip.duration}`,
		description: `${trip.summary} Salidas grupales durante 2027.`,
		url,
		image: new URL('/og-image.jpg', site).href,
		inLanguage: 'es-MX',
		provider: { '@id': `${site}#agency` },
		itinerary: {
			'@type': 'ItemList',
			itemListElement: trip.cities.map((name, i) => ({
				'@type': 'ListItem',
				position: i + 1,
				item: { '@type': 'City', name },
			})),
		},
		...(priced.length && {
			offers: {
				'@type': 'AggregateOffer',
				priceCurrency: 'USD',
				lowPrice: Math.min(...prices),
				highPrice: Math.max(...prices),
				offerCount: priced.length,
				offers: priced.map((d) => ({
					'@type': 'Offer',
					name: `Salida del ${formatRange(d)}`,
					url,
					priceCurrency: 'USD',
					price: d.price,
					seller: { '@id': `${site}#agency` },
				})),
			},
		}),
	};
});

const schema = {
	'@context': 'https://schema.org',
	'@graph': [
		agency,
		{
			'@type': 'WebSite',
			'@id': `${site}#website`,
			url: site,
			name: 'Ala Libre – Viajes grupales a China',
			inLanguage: 'es-MX',
			publisher: { '@id': `${site}#agency` },
		},
		...tripSchema,
	],
};
---

<Layout>
	<script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
	<Menu />
	<Hero />
	<ItinerarySplit />
	<Departures />
	<ContactSection />
	<Footer />
</Layout>
