---
interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const {
	title = 'Viaje a China 14 Días | Ala Libre Agencia de Viajes',
	description = "Descubre China con Ala Libre: 14 días recorriendo Beijing, Xi'an, Guilin, Zhangjiajie y Shanghái. Alojamiento, guías expertos y transporte incluidos. Cotiza tu viaje con un diseñador de viajes.",
	image = '/viajesgrupales.png',
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://china.alalibreagency.com');
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const ogImageURL = new URL(image, siteUrl);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/IsotipoBlanco.png" />
		<link rel="apple-touch-icon" href="/IsotipoBlanco.png" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL.href} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:locale" content="es_MX" />
		<meta property="og:site_name" content="Ala Libre" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=League+Spartan:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	/* ---- Marca Ala Libre ---- */
	:root {
		--alalibre-navy: #00002e; /* principal */
		--alalibre-mist: #e5ebf5; /* secundario */
		--alalibre-aqua: #0aa8c6; /* terciario */
		--font-sans: 'League Spartan', sans-serif;
		--font-display: 'League Spartan', sans-serif;
	}

	html {
		color-scheme: dark;
		scrollbar-color: var(--alalibre-aqua) var(--alalibre-navy);
	}

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		background: var(--alalibre-navy);
	}

	body {
		color: var(--alalibre-mist);
		font-family: var(--font-sans);
		-webkit-font-smoothing: antialiased;
	}

	* {
		box-sizing: border-box;
	}

	::selection {
		background: var(--alalibre-aqua);
		color: var(--alalibre-navy);
	}

	:focus-visible {
		outline: 2px solid var(--alalibre-aqua);
		outline-offset: 3px;
	}

	/* ---- Movimiento ---- */
	@keyframes al-zoom-in {
		from {
			opacity: 0;
			transform: scale(0.93);
		}
		to {
			opacity: 1;
			transform: scale(1);
		}
	}

	@keyframes al-fade-only {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	.al-copy {
		animation: al-zoom-in 760ms cubic-bezier(0.16, 1, 0.3, 1) both;
		transform-origin: bottom left;
	}

	@media (prefers-reduced-motion: reduce) {
		.al-copy {
			animation: al-fade-only 160ms ease both;
		}
	}
</style>
