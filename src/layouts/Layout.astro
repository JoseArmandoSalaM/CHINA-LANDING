---
import { Font } from 'astro:assets';
import Analytics from '../components/Analytics.astro';
import CookieConsent from '../components/CookieConsent.astro';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	imageAlt?: string;
	/** true en páginas que no deben aparecer en Google (p. ej. el 404) */
	noindex?: boolean;
}

const {
	title = 'Viajes Grupales a China 2027 | 17 días y 16 noches',
	description = 'Viaja a China en grupo durante 17 días y 16 noches, recorriendo Beijing, Xi’an, Chengdu, Chongqing, Zhangjiajie, Guilin, Shenzhen y Shanghái.',
	image = '/og-image.jpg',
	imageAlt = 'Viajes grupales a China 2027 con Ala Libre',
	noindex = false,
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://china.alalibreagency.com');
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const ogImageURL = new URL(image, siteUrl);
---

<!doctype html>
<html lang="es-MX">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<link rel="alternate" hreflang="es-MX" href={canonicalURL} />
		<link rel="alternate" hreflang="x-default" href={canonicalURL} />
		<link rel="sitemap" type="application/xml" href="/sitemap.xml" />
		<meta
			name="robots"
			content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1'}
		/>
		<meta name="author" content="Ala Libre" />
		<meta name="theme-color" content="#00002e" />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL.href} />
		<meta property="og:image:alt" content={imageAlt} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:locale" content="es_MX" />
		<meta property="og:site_name" content="Ala Libre" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />
		<meta name="twitter:image:alt" content={imageAlt} />

		<slot name="head" />

		<Font cssVariable="--font-league-spartan" preload={[{ subset: 'latin' }]} />
		<Analytics />
	</head>
	<body>
		<slot />
		<CookieConsent />
	</body>
</html>

<style is:global>
	/* ---- Marca Ala Libre ---- */
	:root {
		--alalibre-navy: #00002e; /* principal */
		--alalibre-mist: #e5ebf5; /* secundario */
		--alalibre-aqua: #0aa8c6; /* terciario */
		--font-sans: var(--font-league-spartan);
		--font-display: var(--font-league-spartan);
	}

	html {
		color-scheme: dark;
		scrollbar-color: var(--alalibre-aqua) var(--alalibre-navy);
	}

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		background: var(--alalibre-navy);
	}

	body {
		color: var(--alalibre-mist);
		font-family: var(--font-sans);
		-webkit-font-smoothing: antialiased;
	}

	* {
		box-sizing: border-box;
	}

	/* Texto solo para lectores de pantalla */
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	::selection {
		background: var(--alalibre-aqua);
		color: var(--alalibre-navy);
	}

	:focus-visible {
		outline: 2px solid var(--alalibre-aqua);
		outline-offset: 3px;
	}

	/* ---- Movimiento ---- */
	@keyframes al-zoom-in {
		from {
			opacity: 0;
			transform: scale(0.93);
		}
		to {
			opacity: 1;
			transform: scale(1);
		}
	}

	@keyframes al-fade-only {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	.al-copy {
		animation: al-zoom-in 760ms cubic-bezier(0.16, 1, 0.3, 1) both;
		transform-origin: bottom left;
	}

	@media (prefers-reduced-motion: reduce) {
		.al-copy {
			animation: al-fade-only 160ms ease both;
		}
	}
</style>
