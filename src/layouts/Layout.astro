---
interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const {
	title = 'Viaje a China 14 Días y 13 Noches | Ala Libre Agencia de Viajes',
	description = "Descubre China con Ala Libre: 14 días recorriendo Beijing, Xi'an, Guilin, Zhangjiajie y Shanghái. Alojamiento, guías expertos y transporte incluidos. Cotiza tu viaje con un diseñador de viajes.",
	image = '/rioli-desktop.webp',
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://china.alalibreagency.com');
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const ogImageURL = new URL(image, siteUrl);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/IsotipoBlanco.png" />
		<link rel="apple-touch-icon" href="/IsotipoBlanco.png" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:locale" content="es_MX" />
		<meta property="og:site_name" content="Ala Libre" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=League+Spartan:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		background: #00002e;
	}

	* {
		box-sizing: border-box;
	}
</style>
