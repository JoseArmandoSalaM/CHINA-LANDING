---
---

<header id="menu">
	<div class="menu-inner">
		<a href="#salidas" class="side-link contact left">Salidas</a>

		<a href="/" class="logo" aria-label="Ala Libre — inicio">
			<picture>
				<img src="/img/isotipo.svg" alt="Ala Libre" width="64" height="64" />
			</picture>
		</a>

		<a href="#contacto" class="side-link contact right">Contacto</a>
	</div>
</header>

<script>
	const header = document.getElementById('menu');
	let scrolled = false;

	// Zona muerta entre 12 y 32px: evita que un scroll con rebote en el borde
	// prenda y apague el blur en cada frame (parpadeo).
	const onScroll = () => {
		const y = window.scrollY;
		const next = scrolled ? y > 12 : y > 32;
		if (next !== scrolled) {
			scrolled = next;
			header?.classList.toggle('scrolled', scrolled);
		}
	};

	// La primera lectura espera a que la página termine de cargar: hacerla antes obliga a calcular el layout de golpe.
	window.addEventListener('load', onScroll, { once: true });
	window.addEventListener('scroll', onScroll, { passive: true });

	// El logo sube al inicio sin recargar cuando ya estamos en la portada.
	document.querySelector('#menu .logo')?.addEventListener('click', (e) => {
		if (window.location.pathname !== '/') return;
		e.preventDefault();
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
		if (window.location.hash) history.replaceState(null, '', window.location.pathname);
	});
</script>

<style>
	#menu {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		width: 100%;
		font-family: var(--font-sans);
		font-weight: 500;
		background: transparent;
		border-bottom: 1px solid transparent;
		transition:
			background-color 0.5s ease,
			border-color 0.5s ease;
	}

	#menu.scrolled {
		background: rgba(0, 0, 46, 0.9);
		border-bottom-color: rgba(255, 255, 255, 0.1);
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
	}

	.menu-inner {
		position: relative;
		max-width: 1600px;
		height: 80px;
		margin: 0 auto;
	}

	.logo {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		display: block;
		filter: drop-shadow(0 1px 10px rgba(0, 0, 20, 0.45));
	}

	.logo img {
		display: block;
		height: 64px;
		width: auto;
		max-width: 260px;
		object-fit: contain;
	}

	.side-link {
		position: absolute;
		top: calc(50% + 6px);
		transform: translateY(-50%);
		color: #ffffff;
		text-decoration: none;
		font-weight: 500;
		font-size: 1.1rem;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		text-underline-offset: 8px;
		text-shadow: 0 1px 14px rgba(0, 0, 20, 0.5);
		transition:
			color 0.3s ease,
			background-color 0.3s ease,
			border-color 0.3s ease;
	}

	.side-link.left {
		right: calc(50% + 70px);
	}

	.side-link.right {
		left: calc(50% + 70px);
	}

	.side-link:hover {
		color: var(--alalibre-aqua);
		text-decoration: underline;
	}

	@media (max-width: 700px) {
		.logo img {
			height: 48px;
		}

		.side-link {
			font-size: 0.9rem;
			letter-spacing: 0.1em;
		}

		.side-link.left {
			right: calc(50% + 44px);
		}

		.side-link.right {
			left: calc(50% + 44px);
		}
	}
</style>
