---
export interface NavLink {
	label: string;
	href: string;
}

const links: NavLink[] = [
	{ label: 'NUESTROS VIAJES', href: 'https://alalibreagency.com/nuestrosviajes-2/' },
	{ label: 'VIAJES GRUPALES', href: 'https://alalibreagency.com/viajes-personalizados-a-tu-medida/' },
	{ label: 'NOSOTROS', href: 'https://alalibreagency.com/nosotros/' },
	{ label: 'NUESTROS VIAJEROS', href: 'https://alalibreagency.com/nuestrosviajeros/' },
];
---

<header id="menu">
	<div class="menu-inner">
		<a href="/" class="logo">
			<picture>
				<source media="(max-width: 700px)" srcset="/logoblanco.png" />
				<img src="/IsotipoBlanco.png" alt="Ala Libre" />
			</picture>
		</a>

		<div class="menu-toggle-wrap">
			<button id="menu-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="nav-links">
				<span id="menu-toggle-label">MENU</span>
			</button>

			<nav id="nav-links">
				<ul>
					{
						links.map((link) => (
							<li>
								<a href={link.href}>{link.label}</a>
							</li>
						))
					}
				</ul>
			</nav>
		</div>
	</div>
</header>

<script>
	const toggle = document.getElementById('menu-toggle');
	const nav = document.getElementById('nav-links');
	const label = document.getElementById('menu-toggle-label');
	const wrap = document.querySelector('.menu-toggle-wrap');

	const setOpen = (isOpen: boolean) => {
		nav?.classList.toggle('open', isOpen);
		toggle?.classList.toggle('open', isOpen);
		toggle?.setAttribute('aria-expanded', String(isOpen));
		if (label) label.textContent = isOpen ? 'CERRAR' : 'MENU';
	};

	toggle?.addEventListener('click', () => {
		setOpen(!nav?.classList.contains('open'));
	});

	document.addEventListener('click', (e) => {
		if (nav?.classList.contains('open') && wrap && !wrap.contains(e.target as Node)) {
			setOpen(false);
		}
	});
</script>

<style>
	#menu {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		width: 100%;
		background: linear-gradient(180deg, rgba(0, 0, 46, 0.6) 0%, rgba(0, 0, 46, 0.25) 65%, rgba(0, 0, 46, 0) 100%);
		font-family: 'League Spartan', sans-serif;
		font-weight: 500;
	}

	.menu-inner {
		position: relative;
		min-height: 110px;
	}

	.logo {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		display: flex;
		align-items: center;
	}

	.logo img {
		display: block;
		height: 90px;
		width: auto;
		max-width: 260px;
		object-fit: contain;
	}

	.menu-toggle-wrap {
		position: fixed;
		top: 28px;
		right: 20px;
		z-index: 100;
		/* Su propia capa de composición: evita que quede afectado si algún
		   backdrop-filter (como el blur de Destinos) tiene un glitch de WebKit. */
		transform: translateZ(0);
		-webkit-transform: translateZ(0);
	}

	#menu-toggle {
		position: relative;
		z-index: 31;
		flex-shrink: 0;
		width: 140px;
		height: 54px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: #00002e;
		border: 1px solid rgba(255, 255, 255, 0.25);
		border-radius: 999px;
		cursor: pointer;
		padding: 0;
		transition: background 0.2s ease;
	}

	#menu-toggle:hover {
		background: rgba(0, 0, 0, 0.6);
	}

	#menu-toggle-label {
		color: #ffffff;
		font-family: 'League Spartan', sans-serif;
		font-weight: 700;
		font-size: 15px;
		letter-spacing: 0.1em;
	}

	#nav-links {
		position: absolute;
		top: 0;
		right: 0;
		z-index: 30;
		width: min(340px, calc(100vw - 64px));
		padding-top: 68px;
		background: #00002e;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 22px;
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
		display: grid;
		grid-template-rows: 0fr;
		opacity: 0;
		pointer-events: none;
		transition:
			grid-template-rows 0.7s cubic-bezier(0.22, 1, 0.36, 1),
			opacity 0.5s ease;
	}

	#nav-links.open {
		grid-template-rows: 1fr;
		opacity: 1;
		pointer-events: auto;
	}

	#nav-links ul {
		overflow: hidden;
		min-height: 0;
		display: flex;
		flex-direction: column;
		gap: 4px;
		list-style: none;
		margin: 0;
		padding: 4px 8px 12px;
	}

	#nav-links li {
		width: 100%;
		text-align: left;
		opacity: 0;
		transform: translateY(-10px);
		transition:
			opacity 0.5s cubic-bezier(0.22, 1, 0.36, 1),
			transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
	}

	#nav-links.open li {
		opacity: 1;
		transform: translateY(0);
	}

	#nav-links.open li:nth-child(1) {
		transition-delay: 0.1s;
	}
	#nav-links.open li:nth-child(2) {
		transition-delay: 0.17s;
	}
	#nav-links.open li:nth-child(3) {
		transition-delay: 0.24s;
	}
	#nav-links.open li:nth-child(4) {
		transition-delay: 0.31s;
	}

	#nav-links a {
		display: block;
		color: #ffffff;
		text-decoration: none;
		font-family: 'League Spartan', sans-serif;
		font-weight: 600;
		font-size: 22px;
		letter-spacing: 0.02em;
		padding: 18px 16px;
		border-radius: 12px;
		transition:
			background 0.3s ease,
			transform 0.3s ease,
			color 0.3s ease;
	}

	#nav-links a:hover {
		background: rgba(255, 255, 255, 0.1);
		transform: translateX(8px);
		color: #0aa8c6;
	}

	@media (max-width: 700px) {
		.menu-inner {
			min-height: 120px;
		}

		.menu-toggle-wrap {
			top: 20px;
			right: 20px;
		}

		.logo {
			top: 20px;
			left: 16px;
			transform: none;
		}

		#nav-links {
			width: min(300px, calc(100vw - 24px));
			padding-top: 60px;
		}

		.logo img {
			height: 46px;
		}

		#menu-toggle {
			width: 100px;
			height: 46px;
		}

		#menu-toggle-label {
			font-size: 12px;
		}
	}
</style>
