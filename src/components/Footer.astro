---

<footer id="site-footer">
	<img class="footer-logo" src="/IsotipoBlanco.png" alt="Ala Libre" loading="lazy" />

	<p class="footer-tagline">
		¡Síguenos en redes sociales y descubre destinos, consejos de viaje y mucho más! ¡Inspírate y
		planea tu próxima aventura!
	</p>

	<div class="footer-socials">
		{
			socials.map((s) => (
				<a href={s.href} aria-label={s.name} target="_blank" rel="noopener noreferrer">
					<svg viewBox="0 0 24 24" fill="currentColor">
						<path d={s.path} />
					</svg>
				</a>
			))
		}
	</div>

	<p class="footer-address">
		5 de Mayo 1004, 12 Oriente, Tentla, Plaza La Joya, 72810, San Andrés Cholula, Puebla, México
	</p>

	<a class="footer-terms" href="#">CONSULTAR TÉRMINOS Y CONDICIONES</a>

	<p class="footer-copy">Copyright © ALA LIBRE 2025</p>
</footer>

<style>
	#site-footer {
		background: #0a0a1a;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		padding: 48px 6vw 24px;
		text-align: center;
		font-family: 'League Spartan', sans-serif;
	}

	.footer-logo {
		height: 56px;
		width: auto;
		margin-bottom: 16px;
	}

	.footer-tagline {
		max-width: 640px;
		margin: 0 auto 20px;
		color: rgba(255, 255, 255, 0.85);
		font-size: 14px;
		line-height: 1.6;
	}

	.footer-socials {
		display: flex;
		justify-content: center;
		gap: 16px;
		margin-bottom: 20px;
	}

	.footer-socials a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.1);
		color: #ffffff;
		transition: background 0.2s ease;
	}

	.footer-socials a:hover {
		background: rgba(255, 255, 255, 0.24);
	}

	.footer-socials svg {
		width: 16px;
		height: 16px;
	}

	.footer-address {
		margin: 0 0 10px;
		color: rgba(255, 255, 255, 0.6);
		font-size: 12.5px;
	}

	.footer-terms {
		display: inline-block;
		margin-bottom: 16px;
		color: rgba(255, 255, 255, 0.6);
		font-size: 11.5px;
		letter-spacing: 0.05em;
		text-decoration: none;
	}

	.footer-terms:hover {
		color: #ffffff;
	}

	.footer-copy {
		margin: 0;
		padding-top: 16px;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		color: rgba(255, 255, 255, 0.45);
		font-size: 11.5px;
	}
</style>
