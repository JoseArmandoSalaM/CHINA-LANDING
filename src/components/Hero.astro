---
import { Picture } from 'astro:assets';
import { totalDepartures } from '../data/trips';
import heroImage from '../assets/hero/taiwanbanner.jpg';
---

<section id="hero">
	<div class="hero-media">
		<Picture
			src={heroImage}
			alt="Viajes grupales a China 2027: puerta monumental iluminada al anochecer"
			widths={[640, 960, 1280, 1600, 1920, 2560]}
			sizes="100vw"
			formats={['avif', 'webp']}
			fallbackFormat="jpg"
			width={2560}
			quality={68}
			loading="eager"
			fetchpriority="high"
			decoding="async"
		/>
		<div class="hero-fade"></div>

		<div class="hero-loader" role="status" aria-label="Cargando">
			<div class="loader-logo" aria-hidden="true">
				<img class="loader-base" src="/img/isotipo.svg" alt="" />
				<img class="loader-fill" src="/img/isotipo.svg" alt="" />
			</div>
		</div>
		<noscript><style>.hero-loader { display: none !important; }</style></noscript>

		<div class="hero-top">
			<div class="china-wrap al-copy">
				<div class="headline">
					<h1>Viajes grupales a China 2027</h1>
					<p class="hero-route">
						Viaja a China en grupo durante 17 días y 16 noches, recorriendo Beijing, Xi’an, Chengdu,
						Chongqing, Zhangjiajie, Guilin, Shenzhen y Shanghái.
					</p>
					<p class="hero-days">{totalDepartures} salidas en 2027 · Itinerarios de 14 y 17 días</p>
				</div>
				<a
					href="https://api.whatsapp.com/send/?phone=522211201356&text=Hola%2C+quiero+viajar+con+Ala+Libre%2C+quiero+comenzar+ahora&type=phone_number&app_absent=0"
					target="_blank"
					rel="noopener noreferrer"
					class="btn-pill"
				>
					<span>Cotizar con un diseñador de viajes</span>
					<span class="btn-arrow" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
							<path d="M9 5l7 7-7 7" />
						</svg>
					</span>
				</a>
			</div>
		</div>

		<span class="seal seal-left" lang="zh" title="Abundancia" aria-label="Abundancia">丰盛</span>
		<span class="seal seal-corner" lang="zh" title="Esperanza" aria-label="Esperanza">希望</span>

		<div class="hero-strip">
			<div class="strip-left">
				<ul class="socials" aria-label="Redes sociales">
					<li><a href="https://www.instagram.com/alalibreagency" target="_blank" rel="noopener noreferrer">Instagram</a></li>
					<li><a href="https://www.facebook.com/alalibreagency" target="_blank" rel="noopener noreferrer">Facebook</a></li>
					<li><a href="https://www.tiktok.com/@alalibreagency" target="_blank" rel="noopener noreferrer">TikTok</a></li>
				</ul>
			</div>
			<a class="scroll-cue" href="#itinerarios">
				<span class="scroll-arrow" aria-hidden="true">
						<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M12 4v15M5 12.5l7 7 7-7" />
						</svg>
					</span>
				<span>Baja para<br />explorar más</span>
			</a>
			<dl class="proof-stats">
				<div>
					<dt>Calificación en Google</dt>
					<dd data-count="4.7">4.7</dd>
				</div>
				<div>
					<dt>Viajeros</dt>
					<dd data-count="4000+">4000+</dd>
				</div>
				<div>
					<dt>Países visitados</dt>
					<dd data-count="20+">20+</dd>
				</div>
			</dl>
		</div>
	</div>
</section>

<script>
	const heroMediaEl = document.querySelector<HTMLElement>('#hero .hero-media');
	const heroImg = heroMediaEl?.querySelector<HTMLImageElement>('img');
	const loaderLogo = heroMediaEl?.querySelector<HTMLElement>('.loader-logo');
	let progress = 0;
	let finishing = false;

	const showProgress = () => loaderLogo?.style.setProperty('--p', progress.toFixed(1));

	// Progreso simulado: sube rápido y se frena en 90% hasta que el banner termina de cargar.
	const creep = () => {
		if (finishing) return;
		progress += (90 - progress) * 0.035;
		showProgress();
		requestAnimationFrame(creep);
	};

	const markLoaded = () => {
		if (finishing) return;
		finishing = true;
		const from = progress;
		const start = performance.now();
		const fill = (now: number) => {
			const t = Math.min((now - start) / 350, 1);
			progress = from + (100 - from) * t;
			showProgress();
			if (t < 1) requestAnimationFrame(fill);
			else setTimeout(() => heroMediaEl?.classList.add('is-loaded'), 150);
		};
		requestAnimationFrame(fill);
	};

	if (!heroImg || heroImg.complete) {
		heroMediaEl?.classList.add('is-loaded');
	} else {
		requestAnimationFrame(creep);
		heroImg.addEventListener('load', markLoaded, { once: true });
		heroImg.addEventListener('error', markLoaded, { once: true });
	}

	const CYCLES = 3;
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	document.querySelectorAll<HTMLElement>('#hero [data-count]').forEach((el, n) => {
		const value = el.dataset.count ?? '';
		el.textContent = '';
		const readable = document.createElement('span');
		readable.className = 'sr-only';
		readable.textContent = value;
		el.append(readable);

		const reels: { strip: HTMLElement; target: number; order: number }[] = [];
		let order = 0;

		for (const ch of value) {
			if (ch < '0' || ch > '9') {
				const sym = document.createElement('span');
				sym.className = 'reel-sym';
				sym.setAttribute('aria-hidden', 'true');
				sym.textContent = ch;
				el.append(sym);
				continue;
			}
			const target = Number(ch);
			const reel = document.createElement('span');
			reel.className = 'reel';
			reel.setAttribute('aria-hidden', 'true');
			const strip = document.createElement('span');
			strip.className = 'reel-strip';
			const steps = reduce ? target + 1 : CYCLES * 10 + target + 1;
			for (let i = 0; i < steps; i++) {
				const d = document.createElement('span');
				d.textContent = String(i % 10);
				strip.append(d);
			}
			reel.append(strip);
			el.append(reel);
			reels.push({ strip, target, order: order++ });
			if (reduce) strip.style.transform = `translateY(-${target}em)`;
		}

		if (reduce) return;

		const run = () => {
			for (const { strip, target, order: o } of reels) {
				const end = CYCLES * 10 + target;
				strip.animate(
					[
						{ transform: 'translateY(0)', filter: 'blur(2px)' },
						{ filter: 'blur(1.5px)', offset: 0.6 },
						{ transform: `translateY(-${end}em)`, filter: 'blur(0)' },
					],
					{
						duration: 2200 + o * 350 + n * 200,
						delay: 300,
						easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
						fill: 'forwards',
					}
				);
			}
		};

		const io = new IntersectionObserver(
			(entries) => {
				if (entries[0].isIntersecting) {
					run();
					io.disconnect();
				}
			},
			{ threshold: 0.4 }
		);
		io.observe(el);
	});

	const heroMedia = document.querySelector<HTMLElement>('#hero .hero-media');
	const seals = document.querySelectorAll<HTMLElement>('#hero .seal');
	const MENU_EDGE = 57;
	let ticking = false;

	const updateSeals = () => {
		ticking = false;
		if (!heroMedia) return;
		const restTop = heroMedia.getBoundingClientRect().top + window.innerHeight * 0.13;
		seals.forEach((seal) => seal.classList.toggle('is-stuck', restTop <= MENU_EDGE));
	};

	window.addEventListener(
		'scroll',
		() => {
			if (!ticking) {
				ticking = true;
				requestAnimationFrame(updateSeals);
			}
		},
		{ passive: true }
	);
	window.addEventListener('resize', updateSeals);
	requestAnimationFrame(updateSeals);

	if (!reduce) {
		document.querySelectorAll<HTMLElement>('#hero .seal').forEach((seal) => {
			seal.addEventListener('pointermove', (e) => {
				const r = seal.getBoundingClientRect();
				const px = (e.clientX - r.left) / r.width - 0.5;
				const py = (e.clientY - r.top) / r.height - 0.5;
				seal.style.setProperty('--ry', `${px * 26}deg`);
				seal.style.setProperty('--rx', `${-py * 26}deg`);
			});
			seal.addEventListener('pointerleave', () => {
				seal.style.setProperty('--rx', '0deg');
				seal.style.setProperty('--ry', '0deg');
			});
		});
	}
</script>

<style>
	#hero {
		--gold: #d9b26a;
		position: relative;
		width: 100%;
		overflow: hidden;
		background: var(--alalibre-navy);
		font-family: var(--font-sans);
	}

	.hero-media {
		position: relative;
		width: 100%;
		height: 100vh;
		min-height: 460px;
		overflow: hidden;
	}

	.hero-media > :global(picture) :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 40%;
		display: block;
	}

	.hero-loader {
		position: absolute;
		inset: 0;
		z-index: 90;
		display: grid;
		place-items: center;
		background: rgba(0, 0, 0, 0.9);
		transition:
			opacity 0.6s ease,
			visibility 0s linear 0.6s;
	}

	.hero-media.is-loaded .hero-loader {
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
	}

	.loader-logo {
		position: relative;
		width: 96px;
		height: 96px;
		--p: 0;
	}

	.loader-logo img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.loader-base {
		opacity: 0.18;
	}

	.loader-fill {
		clip-path: inset(calc(100% - var(--p) * 1%) 0 0 0);
	}

	.hero-fade {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			180deg,
			rgba(0, 0, 46, 0.55) 0%,
			rgba(0, 0, 46, 0.1) 40%,
			rgba(0, 0, 46, 0.3) 70%,
			rgba(0, 0, 46, 0.8) 100%
		);
	}

	.hero-top {
		position: absolute;
		inset: 0;
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: flex-end;
		padding: 90px 6vw calc(5vh + 64px);
	}

	.china-wrap {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 30px;
		max-width: 100%;
	}

	.headline {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 18px;
	}

	.hero-top h1 {
		margin: 0;
		color: #ffffff;
		font-weight: 800;
		font-size: clamp(24px, 2.9vw, 88px);
		white-space: nowrap;
		text-transform: uppercase;
		line-height: 1.02;
		letter-spacing: -0.015em;
		text-align: left;
		text-shadow: 0 4px 24px rgba(0, 0, 0, 0.35);
	}

	.hero-route {
		margin: 0;
		color: var(--alalibre-mist);
		font-weight: 500;
		font-size: clamp(12px, 0.95vw, 28px);
		letter-spacing: 0.02em;
		line-height: 1.5;
		text-align: left;
		/* No aporta ancho propio: se ajusta al ancho del h1 y salta de línea. */
		width: 0;
		min-width: 100%;
		text-wrap: balance;
		text-shadow: 0 2px 12px rgba(0, 0, 0, 0.5);
	}

	.hero-days {
		margin: 0;
		color: #ffffff;
		font-weight: 600;
		font-size: clamp(15px, 1.4vw, 42px);
		line-height: 1.4;
		text-align: left;
		text-shadow: 0 2px 12px rgba(0, 0, 0, 0.5);
	}

	.btn-pill {
		display: inline-flex;
		align-items: center;
		gap: 18px;
		padding: 6px 6px 6px 24px;
		color: #ffffff;
		text-decoration: none;
		font-weight: 600;
		font-size: clamp(14px, 1.2vw, 28px);
		border-radius: 999px;
		background: rgba(0, 0, 30, 0.35);
		border: 1px solid rgba(255, 255, 255, 0.55);
		backdrop-filter: blur(6px);
		transition:
			background 0.25s ease,
			border-color 0.25s ease;
	}

	.btn-arrow {
		display: grid;
		place-items: center;
		width: max(38px, 2.25em);
		height: max(38px, 2.25em);
		flex: none;
		border-radius: 50%;
		background: var(--gold);
		color: var(--alalibre-navy);
		transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.btn-arrow svg {
		width: 1em;
		height: 1em;
	}

	.btn-pill:hover {
		background: rgba(0, 0, 30, 0.6);
		border-color: var(--gold);
	}

	.btn-pill:hover .btn-arrow {
		transform: translateX(4px);
	}

	.seal {
		position: absolute;
		z-index: 101;
		display: grid;
		place-items: center;
		width: 60px;
		padding: 16px 0;
		color: #ffffff;
		font-family: 'Microsoft YaHei', 'PingFang SC', 'Noto Sans SC', sans-serif;
		font-size: 24px;
		font-weight: 700;
		line-height: 1.25;
		writing-mode: vertical-rl;
		text-orientation: upright;
		letter-spacing: 0.1em;
		background: rgba(255, 255, 255, 0.14);
		border: 1px solid rgba(255, 255, 255, 0.6);
		border-radius: 12px;
		backdrop-filter: blur(6px);
		text-shadow: 0 1px 8px rgba(0, 0, 20, 0.5);
		user-select: none;
		transform: perspective(500px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
		transition:
			transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
			background 0.3s ease,
			border-color 0.3s ease,
			box-shadow 0.3s ease,
			color 0.3s ease;
	}

	@media (hover: hover) and (prefers-reduced-motion: no-preference) {
		.seal:hover {
			transform: perspective(500px) translateY(-6px) scale(1.08) rotateX(var(--rx, 0deg))
				rotateY(var(--ry, 0deg));
			background: rgba(255, 255, 255, 0.22);
			border-color: var(--gold);
			color: var(--gold);
			box-shadow: 0 16px 32px rgba(0, 0, 20, 0.5);
		}
	}

	.seal-left {
		left: 1.6vw;
		top: 13vh;
	}

	.seal.is-stuck {
		position: fixed;
		top: 57px;
	}

	.seal-corner {
		right: 1.6vw;
		top: 13vh;
	}

	.hero-strip {
		position: absolute;
		left: 6vw;
		right: 6vw;
		bottom: 5vh;
		z-index: 2;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: end;
		gap: 24px;
		color: #ffffff;
	}

	.proof-stats {
		justify-self: end;
	}

	.scroll-cue {
		display: flex;
		align-items: center;
		gap: 14px;
		color: #ffffff;
		text-decoration: none;
		font-size: clamp(12px, 0.95vw, 22px);
		font-weight: 600;
		line-height: 1.3;
		text-shadow: 0 2px 10px rgba(0, 0, 20, 0.6);
	}

	.scroll-arrow {
		display: grid;
		place-items: center;
		flex: none;
		animation: bounce 1.6s cubic-bezier(0.28, 0.84, 0.42, 1) infinite;
	}

	.scroll-arrow svg {
		width: 26px;
		height: 26px;
	}

	@keyframes bounce {
		0%,
		100% {
			transform: translateY(-6px);
		}
		50% {
			transform: translateY(6px);
		}
	}

	.scroll-cue:hover {
		color: var(--gold);
	}

	.socials {
		display: flex;
		gap: 28px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.socials a {
		color: #ffffff;
		text-decoration: none;
		font-size: clamp(11px, 0.9vw, 20px);
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		text-shadow: 0 2px 10px rgba(0, 0, 20, 0.6);
		transition: color 0.2s ease;
	}

	.socials a:hover {
		color: var(--alalibre-aqua);
	}

	.proof-stats {
		display: flex;
		gap: clamp(24px, 3.6vw, 56px);
		margin: 0;
		text-shadow: 0 2px 14px rgba(0, 0, 20, 0.6);
	}

	.proof-stats div {
		display: flex;
		flex-direction: column-reverse;
		align-items: center;
		text-align: center;
		gap: 6px;
	}

	.proof-stats dt {
		font-size: clamp(12px, 1vw, 24px);
		font-weight: 500;
		color: var(--alalibre-mist);
	}

	.proof-stats dd {
		margin: 0;
		font-size: clamp(24px, 2.4vw, 68px);
		font-weight: 700;
		line-height: 1;
		font-variant-numeric: tabular-nums;
	}

	.proof-stats dd :global(.reel) {
		display: inline-block;
		height: 1em;
		width: 1ch;
		overflow: hidden;
		vertical-align: top;
	}

	.proof-stats dd :global(.reel-strip) {
		display: flex;
		flex-direction: column;
		will-change: transform;
	}

	.proof-stats dd :global(.reel-strip span) {
		display: block;
		height: 1em;
		line-height: 1;
		text-align: center;
	}

	.proof-stats dd :global(.reel-sym) {
		display: inline-block;
		height: 1em;
		line-height: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.scroll-arrow {
			animation: none;
		}
	}

	@media (max-width: 700px) {
		.seal {
			width: 52px;
			padding: 12px 0;
			font-size: 21px;
			border-radius: 10px;
		}

		.hero-media {
			height: 100vh;
			height: 100svh;
			min-height: 640px;
		}

		.hero-top {
			justify-content: flex-end;
			padding: 96px 6vw 140px;
		}

		.china-wrap {
			gap: 20px;
		}

		.headline {
			flex-direction: column;
			align-items: flex-start;
			gap: 14px;
		}

		.hero-top h1 {
			white-space: normal;
			font-size: 32px;
		}

		.hero-route {
			width: auto;
			min-width: 0;
			font-size: 13px;
		}

		.hero-days {
			margin: 0;
			font-size: 16px;
		}

		.btn-pill {
			gap: 14px;
			padding: 5px 5px 5px 20px;
			font-size: 14px;
		}

		.btn-arrow {
			width: 34px;
			height: 34px;
		}

		.hero-strip,
		.strip-left {
			display: contents;
		}

		.scroll-cue {
			display: none;
		}

		.socials {
			display: none;
		}

		.proof-stats {
			position: absolute;
			left: 0;
			right: 0;
			bottom: 32px;
			z-index: 2;
			justify-self: auto;
			align-items: center;
			justify-content: space-between;
			gap: 14px;
		}

		.proof-stats::before,
		.proof-stats::after {
			content: '';
			flex: 1 1 0;
			min-width: 12px;
			height: 2px;
			background: rgba(255, 255, 255, 0.85);
			box-shadow: 0 1px 8px rgba(0, 0, 20, 0.5);
		}

		.proof-stats::before {
			order: 0;
		}

		.proof-stats::after {
			order: 4;
		}

		.proof-stats div:nth-child(2) {
			order: 1;
		}

		.proof-stats div:nth-child(1) {
			order: 2;
		}

		.proof-stats div:nth-child(3) {
			order: 3;
		}

		.proof-stats dt {
			font-size: 12px;
			line-height: 1.25;
			white-space: nowrap;
		}

		.proof-stats dd {
			font-size: 24px;
		}
	}
</style>
