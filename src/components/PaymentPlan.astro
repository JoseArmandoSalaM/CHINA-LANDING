---
import { trips, formatRange, whatsappLink, PAYMENT_PLAN } from '../data/trips';

// Solo se ofrecen las salidas con precio cargado.
const planTrips = trips.map((t) => ({
	slug: t.slug,
	name: t.name,
	duration: t.duration,
	departures: t.departures
		.filter((d) => d.priceDouble)
		.map((d) => ({
			start: d.start,
			// El rango completo (con año) abreviando los nombres de mes, para que quepa en el chip.
			short: formatRange(d).replace(/[A-Za-zÁÉÍÓÚáéíóú]{4,}/g, (m) => m.slice(0, 3)),
			range: formatRange(d),
			priceDouble: d.priceDouble!,
			priceSingle: d.priceSingle ?? null,
		})),
}));

const cheapest = (i: number) => Math.min(...planTrips[i].departures.map((d) => d.priceDouble));
const money = (n: number) => `$${n.toLocaleString('en-US')}`;

const config = {
	...PAYMENT_PLAN,
	trips: planTrips,
	wa: whatsappLink('__TEXT__'),
};
const firstMonths = 6;
const coveragePct = Math.round(PAYMENT_PLAN.firstPaymentCoverage * 100);
---

<section id="plan-de-pagos" class="pp" aria-labelledby="pp-title">
	<h2 id="pp-title">VIAJA A CHINA 2027 A TU RITMO</h2>
	<p class="pp-lead">
		Aparta tu lugar con un anticipo y paga el resto en mensualidades. Arma tu plan y ve al instante
		cuánto y cuándo pagas.
	</p>

	<div class="pp-grid">
		<form class="pp-form" id="pp-form" novalidate>
			<div class="pp-col">
			<fieldset class="pp-field">
				<legend>Elige tu viaje</legend>
				<div class="pp-trips">
					{
						planTrips.map((t, i) => (
							<label class="pp-opt pp-trip">
								<input type="radio" name="trip" value={i} checked={i === 0} />
								<span class="pp-trip-name">{t.name}</span>
								<span class="pp-trip-meta">
									{t.duration} · desde {money(cheapest(i))}
								</span>
							</label>
						))
					}
				</div>
			</fieldset>

			<fieldset class="pp-field">
				<legend>Fecha de salida</legend>
				{
					planTrips.map((t, i) => (
						<div class="pp-chips" data-trip-dates={i} hidden={i !== 0}>
							{t.departures.map((d, j) => (
								<label class="pp-opt pp-chip">
									<input type="radio" name={`dep-${i}`} value={j} checked={j === 0} />
									<span>{d.short}</span>
								</label>
							))}
						</div>
					))
				}
			</fieldset>
			</div>

			<div class="pp-col">
			<div class="pp-row">
				<fieldset class="pp-field">
					<legend class="pp-legend-row">
						Habitación
						<button
							type="button"
							class="pp-info-btn"
							id="pp-occ-info"
							aria-label="Qué significa ocupación doble y sencilla"
							aria-expanded="false"
							aria-controls="pp-occ-popover"
						>!</button>
					</legend>
					<div class="pp-popover" id="pp-occ-popover" role="dialog" aria-label="Ocupación doble y sencilla" hidden>
						<button type="button" class="pp-popover-close" id="pp-occ-popover-close" aria-label="Cerrar">
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
						</button>
						<p><strong>Doble:</strong> 2 personas comparten el cuarto; el precio es por persona.</p>
						<p><strong>Sencilla:</strong> viajas solo; el precio por persona es más alto porque no se comparte el costo del cuarto.</p>
					</div>
					<div class="pp-seg">
						<label class="pp-opt">
							<input type="radio" name="occ" value="double" checked />
							<span>Doble</span>
						</label>
						<label class="pp-opt">
							<input type="radio" name="occ" value="single" />
							<span>Sencilla</span>
						</label>
					</div>
				</fieldset>

				<fieldset class="pp-field">
					<legend>Viajeros</legend>
					<div class="pp-stepper">
						<button type="button" id="pp-less" aria-label="Menos viajeros">
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"></path></svg>
						</button>
						<output id="pp-travelers" aria-live="polite">2</output>
						<button type="button" id="pp-more" aria-label="Más viajeros">
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5v14"></path></svg>
						</button>
					</div>
				</fieldset>
			</div>

			<div class="pp-field pp-months">
				<label for="pp-range" class="pp-legend-like">Meses para pagar</label>
				<div class="pp-months-head">
					<output id="pp-months-out" for="pp-range">{firstMonths} meses</output>
					<span id="pp-max-hint" class="pp-max-hint"></span>
				</div>
				<input
					type="range"
					id="pp-range"
					class="pp-range"
					min="1"
					max={PAYMENT_PLAN.maxMonths}
					step="1"
					value={firstMonths}
					aria-describedby="pp-rule"
				/>
				<p id="pp-rule" class="pp-rule">El pago debe quedar cubierto 60 días antes de la salida.</p>
			</div>
			</div>

			<div class="pp-bottom">
			<dl class="pp-ledger" id="pp-ledger" aria-live="polite">
				<div>
					<dt>Total del viaje</dt>
					<dd data-l="total">—</dd>
				</div>
				<div>
					<dt>Anticipo hoy</dt>
					<dd data-l="deposit">—</dd>
				</div>
				<div>
					<dt data-l="balance-label">Saldo</dt>
					<dd data-l="balance">—</dd>
				</div>
				<div>
					<dt>Primer pago <small>(completas el {coveragePct}%)</small></dt>
					<dd data-l="first">—</dd>
				</div>
				<div data-l-row="next">
					<dt>Después, cada mes ≈</dt>
					<dd data-l="next">—</dd>
				</div>
			</dl>

			<div class="pp-action">
				<p class="pp-action-hint">Genera tu plan y ve fecha por fecha cuánto pagas.</p>
				<p id="pp-blocked" class="pp-blocked" hidden></p>
				<button type="submit" class="pp-generate" id="pp-generate">
					<span>Generar mi plan de pagos</span>
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
				</button>
			</div>
			</div>
		</form>

		<div class="pp-result" id="pp-result" data-state="idle" aria-live="polite" aria-busy="false">
			<div class="pp-idle" id="pp-idle">
				<p class="pp-idle-title">Tu plan de pagos aparecerá aquí</p>
				<ol class="pp-plan pp-ghost" aria-hidden="true">
					<li><span class="pp-node"></span><span class="pp-what">Hoy · tu anticipo</span></li>
					<li><span class="pp-node"></span><span class="pp-what">Cada mes · tus mensualidades</span></li>
					<li><span class="pp-node"></span><span class="pp-what">60 días antes · viaje liquidado</span></li>
					<li><span class="pp-node pp-node-dep"></span><span class="pp-what">Salida a China</span></li>
				</ol>
			</div>
			<div class="pp-loading" id="pp-loading" hidden>
				<div class="pp-loader" aria-hidden="true">
					<span></span><span></span><span></span><span></span>
				</div>
				<p class="pp-loading-title">Generando tu plan de pagos perfecto…</p>
				<p class="pp-loading-sub" id="pp-loading-sub"></p>
			</div>
			<div class="pp-out" id="pp-out" hidden></div>
		</div>
	</div>

	<p class="pp-foot">*Plan de referencia en pesos mexicanos (MXN). Consulta condiciones y disponibilidad con tu asesor.</p>

	<script id="pp-config" type="application/json" set:html={JSON.stringify(config)} />
</section>

<script>
	interface Dep {
		start: string;
		short: string;
		range: string;
		priceDouble: number;
		priceSingle: number | null;
	}
	interface PlanTrip {
		slug: string;
		name: string;
		duration: string;
		departures: Dep[];
	}
	interface Config {
		depositPerPerson: number;
		firstPaymentCoverage: number;
		settleDaysBefore: number;
		maxMonths: number;
		maxTravelers: number;
		trips: PlanTrip[];
		wa: string;
	}
	interface Payment {
		date: Date;
		amount: number;
		cum: number;
	}

	const root = document.getElementById('plan-de-pagos');
	const cfg: Config | null = root
		? JSON.parse(document.getElementById('pp-config')!.textContent || 'null')
		: null;

	if (root && cfg) {
		const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
		const form = $<HTMLFormElement>('pp-form');
		const range = $<HTMLInputElement>('pp-range');
		const monthsOut = $('pp-months-out');
		const maxHint = $('pp-max-hint');
		const rule = $('pp-rule');
		const travelersOut = $('pp-travelers');
		const lessBtn = $<HTMLButtonElement>('pp-less');
		const moreBtn = $<HTMLButtonElement>('pp-more');
		const ledger = $('pp-ledger');
		const blocked = $('pp-blocked');
		const generate = $<HTMLButtonElement>('pp-generate');
		const result = $('pp-result');
		const idle = $('pp-idle');
		const loading = $('pp-loading');
		const loadingSub = $('pp-loading-sub');
		const out = $('pp-out');

		// ---------- Info: qué es ocupación doble/sencilla ----------
		const occInfoBtn = $<HTMLButtonElement>('pp-occ-info');
		const occPopover = $('pp-occ-popover');
		const occPopoverClose = $<HTMLButtonElement>('pp-occ-popover-close');

		// Posición en pantalla (no relativa a la tarjeta): así nunca se encima con otros controles
		// sin importar el tamaño de la tarjeta o el ancho de pantalla.
		const placeOccPopover = () => {
			const rect = occInfoBtn.getBoundingClientRect();
			const width = occPopover.offsetWidth || 260;
			let left = rect.left;
			if (left + width > window.innerWidth - 16) left = window.innerWidth - width - 16;
			if (left < 16) left = 16;
			occPopover.style.left = `${left}px`;
			occPopover.style.top = `${rect.bottom + 8}px`;
		};
		const closeOccInfo = () => {
			occPopover.hidden = true;
			occInfoBtn.setAttribute('aria-expanded', 'false');
		};
		const toggleOccInfo = () => {
			const open = occPopover.hidden;
			if (open) placeOccPopover();
			occPopover.hidden = !open;
			occInfoBtn.setAttribute('aria-expanded', String(open));
			if (open) occPopoverClose.focus();
		};
		occInfoBtn.addEventListener('click', toggleOccInfo);
		occPopoverClose.addEventListener('click', () => {
			closeOccInfo();
			occInfoBtn.focus();
		});
		document.addEventListener('click', (e) => {
			if (!occPopover.hidden && !occPopover.contains(e.target as Node) && e.target !== occInfoBtn) closeOccInfo();
		});
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && !occPopover.hidden) {
				closeOccInfo();
				occInfoBtn.focus();
			}
		});
		// Al hacer scroll el popover (position:fixed) se quedaría "flotando" lejos del botón: mejor cerrarlo.
		window.addEventListener(
			'scroll',
			() => {
				if (!occPopover.hidden) closeOccInfo();
			},
			{ passive: true }
		);

		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const MONTHS = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
		const money = (n: number) => `$${Math.round(n).toLocaleString('en-US')}`;
		const fmtDate = (d: Date) => `${d.getDate()} ${MONTHS[d.getMonth()]} ${d.getFullYear()}`;
		const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;

		const parseISO = (iso: string) => {
			const [y, m, d] = iso.split('-').map(Number);
			return new Date(y, m - 1, d);
		};
		const addMonths = (date: Date, n: number) => {
			const r = new Date(date.getFullYear(), date.getMonth() + n, 1);
			const last = new Date(r.getFullYear(), r.getMonth() + 1, 0).getDate();
			r.setDate(Math.min(date.getDate(), last));
			return r;
		};
		const addDays = (date: Date, n: number) => {
			const r = new Date(date);
			r.setDate(r.getDate() + n);
			return r;
		};
		const now = new Date();
		const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());

		let travelers = 2;
		let generated = false;
		let timers: number[] = [];

		// ---------- Estado actual del formulario ----------
		const tripIdx = () => Number(form.querySelector<HTMLInputElement>('input[name="trip"]:checked')?.value ?? 0);
		const depIdx = () =>
			Number(form.querySelector<HTMLInputElement>(`input[name="dep-${tripIdx()}"]:checked`)?.value ?? 0);
		const occupancy = () =>
			form.querySelector<HTMLInputElement>('input[name="occ"]:checked')?.value === 'single' ? 'single' : 'double';
		const current = () => {
			const trip = cfg.trips[tripIdx()];
			return { trip, dep: trip.departures[depIdx()] };
		};

		// Última mensualidad posible: el pago debe quedar cubierto `settleDaysBefore` días antes de la salida.
		const deadlineOf = (dep: Dep) => addDays(parseISO(dep.start), -cfg.settleDaysBefore);
		const DAY_MS = 24 * 60 * 60 * 1000;
		// Si entre el último mes completo y la fecha límite sobran 15 días o más, se ofrece un pago extra
		// justo en la fecha límite (en vez de dejar esos días sin usar).
		const maxMonthsFor = (dep: Dep) => {
			const deadline = deadlineOf(dep);
			let n = 0;
			for (let i = 1; i <= cfg.maxMonths; i++) if (addMonths(today, i) <= deadline) n = i;
			const lastFull = n > 0 ? addMonths(today, n) : today;
			const slackDays = Math.round((deadline.getTime() - lastFull.getTime()) / DAY_MS);
			if (slackDays >= 15 && n < cfg.maxMonths) n += 1;
			return n;
		};
		const pricePerPerson = (dep: Dep) => (occupancy() === 'single' && dep.priceSingle ? dep.priceSingle : dep.priceDouble);

		const buildPlan = (dep: Dep, months: number) => {
			const total = pricePerPerson(dep) * travelers;
			const deposit = Math.min(cfg.depositPerPerson * travelers, total);
			const balance = total - deposit;
			const amounts: number[] = [];
			if (months === 1) {
				amounts.push(balance);
			} else {
				// El primer pago lleva el acumulado (anticipo + primer pago) al % pedido; nunca menos que una parte igual.
				const target = Math.round(total * cfg.firstPaymentCoverage);
				const first = Math.min(balance, Math.max(target - deposit, Math.ceil(balance / months)));
				const rest = balance - first;
				const base = Math.floor(rest / (months - 1));
				amounts.push(first);
				for (let i = 1; i < months; i++) amounts.push(base);
				amounts[months - 1] += rest - base * (months - 1);
			}
			// El último pago no puede caer después de la fecha límite: si el mes completo se pasa
			// (el pago extra por los días que sobraban), se recorta justo a esa fecha.
			const deadline = deadlineOf(dep);
			let cum = deposit;
			const payments: Payment[] = amounts.map((amount, i) => {
				cum += amount;
				const date = addMonths(today, i + 1);
				return { date: date > deadline ? deadline : date, amount, cum };
			});
			return { total, deposit, balance, payments, next: months > 1 ? amounts[1] : 0 };
		};

		// ---------- Pintar controles y resumen ----------
		let legendTimer = 0;
		const flashRule = () => {
			rule.classList.remove('is-flash');
			void rule.offsetWidth;
			rule.classList.add('is-flash');
			window.clearTimeout(legendTimer);
			legendTimer = window.setTimeout(() => rule.classList.remove('is-flash'), 2400);
		};

		const paintRange = (max: number) => {
			const v = Number(range.value);
			const span = cfg.maxMonths - 1;
			range.style.setProperty('--v', `${((v - 1) / span) * 100}%`);
			range.style.setProperty('--l', `${(Math.max(max, 1) - 1) / span * 100}%`);
			monthsOut.textContent = plural(v, 'mes', 'meses');
		};

		const sync = (announce = true) => {
			const { dep } = current();
			const max = maxMonthsFor(dep);
			let months = Number(range.value);

			if (max < 1) {
				range.disabled = true;
				blocked.hidden = false;
				blocked.textContent =
					'Esta salida está muy cerca para pagar en mensualidades: el viaje debe quedar liquidado 60 días antes. Escríbenos y te ayudamos con el pago.';
				generate.disabled = true;
				maxHint.textContent = '';
				paintRange(1);
				ledger.querySelectorAll('dd').forEach((dd) => (dd.textContent = '—'));
				return;
			}
			range.disabled = false;
			blocked.hidden = true;
			generate.disabled = false;

			if (months > max) {
				months = max;
				range.value = String(max);
				if (announce) flashRule();
			}
			paintRange(max);
			maxHint.textContent = `Máximo para esta salida: ${plural(max, 'mes', 'meses')}`;

			const plan = buildPlan(dep, months);
			const set = (k: string, text: string) => {
				const el = ledger.querySelector(`[data-l="${k}"]`);
				if (el) el.textContent = text;
			};
			set('total', money(plan.total));
			set('deposit', money(plan.deposit));
			set('balance-label', `Saldo en ${plural(months, 'pago', 'pagos')}`);
			set('balance', money(plan.balance));
			set('first', money(plan.payments[0].amount));
			set('next', months > 1 ? money(plan.next) : '—');
			ledger.querySelector<HTMLElement>('[data-l-row="next"]')!.hidden = months === 1;

			travelersOut.textContent = String(travelers);
			lessBtn.disabled = travelers <= 1;
			moreBtn.disabled = travelers >= cfg.maxTravelers;

			if (generated) resetPlan();
		};

		// Si el visitante cambia cualquier dato, el plan generado desaparece: no queda una tabla que ya no corresponde.
		const resetPlan = () => {
			generated = false;
			out.innerHTML = '';
			show('idle');
		};

		// ---------- Eventos de los controles ----------
		form.addEventListener('change', (e) => {
			const t = e.target as HTMLInputElement;
			if (t.name === 'trip') {
				form.querySelectorAll<HTMLElement>('[data-trip-dates]').forEach((g) => {
					g.hidden = Number(g.dataset.tripDates) !== tripIdx();
				});
			}
			sync();
		});

		range.addEventListener('input', () => {
			const { dep } = current();
			const max = maxMonthsFor(dep);
			if (max >= 1 && Number(range.value) > max) {
				range.value = String(max);
				flashRule();
			}
			sync();
		});

		lessBtn.addEventListener('click', () => {
			travelers = Math.max(1, travelers - 1);
			sync();
		});
		moreBtn.addEventListener('click', () => {
			travelers = Math.min(cfg.maxTravelers, travelers + 1);
			sync();
		});

		// ---------- Generar el plan ----------
		const clearTimers = () => {
			timers.forEach((t) => window.clearTimeout(t));
			timers = [];
		};

		const show = (state: 'idle' | 'loading' | 'result') => {
			result.dataset.state = state;
			idle.hidden = state !== 'idle';
			loading.hidden = state !== 'loading';
			out.hidden = state !== 'result';
			result.setAttribute('aria-busy', String(state === 'loading'));
		};

		const renderResult = () => {
			const { trip, dep } = current();
			const months = Number(range.value);
			const plan = buildPlan(dep, months);
			const deadline = deadlineOf(dep);
			const occ = occupancy() === 'single' ? 'sencilla' : 'doble';
			const pct = (cum: number) => Math.round((cum / plan.total) * 100);

			const rows: string[] = [];
			let i = 0;
			rows.push(`
				<li style="--i:${i++}">
					<span class="pp-node"></span>
					<span class="pp-when"><strong>${fmtDate(today)}</strong><span class="pp-what">Anticipo · hoy</span></span>
					<span class="pp-amt">${money(plan.deposit)}<small>${pct(plan.deposit)}% pagado</small></span>
				</li>`);
			plan.payments.forEach((p, k) => {
				const last = k === plan.payments.length - 1;
				rows.push(`
				<li style="--i:${i++}"${last ? ' class="pp-last"' : ''}>
					<span class="pp-node"></span>
					<span class="pp-when"><strong>${fmtDate(p.date)}</strong><span class="pp-what">Pago ${k + 1} de ${plan.payments.length}${last ? '<em>Liquidado</em>' : ''}</span></span>
					<span class="pp-amt">${money(p.amount)}<small>${pct(p.cum)}% pagado</small></span>
				</li>`);
			});
			rows.push(`
				<li style="--i:${i++}" class="pp-dep">
					<span class="pp-node pp-node-dep"></span>
					<span class="pp-when"><strong>${fmtDate(parseISO(dep.start))}</strong><span class="pp-what">Salida a China</span></span>
					<span class="pp-amt pp-amt-plane">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 13.5 21 4l-4.5 16-5-5.5-3 3v-4.5L2.5 13.5Z"></path></svg>
					</span>
				</li>`);

			const msg =
				`Hola, quiero apartar mi lugar con Ala Libre: ${trip.name}, salida del ${dep.range}. ` +
				`${plural(travelers, 'viajero', 'viajeros')}, habitación ${occ}. ` +
				`Plan: anticipo de ${money(plan.deposit)} y ${plural(months, 'pago mensual', 'pagos mensuales')}, ` +
				`total ${money(plan.total)} MXN.`;

			out.style.setProperty('--n', String(rows.length));
			out.innerHTML = `
				<div class="pp-out-head">
					<h3>Tu plan de pagos</h3>
					<p>${trip.name} · ${dep.range}</p>
					<p>${plural(travelers, 'viajero', 'viajeros')} · habitación ${occ} · liquidado a más tardar el ${fmtDate(deadline)}</p>
				</div>
				<ol class="pp-plan">${rows.join('')}</ol>
				<div class="pp-out-foot">
				<div class="pp-total"><span>Total del viaje</span><strong>${money(plan.total)} MXN</strong></div>
				<a class="pp-cta" href="${cfg.wa.replace('__TEXT__', encodeURIComponent(msg))}" target="_blank" rel="noopener noreferrer">
					Quiero apartar mi lugar
				</a>
				</div>`;
			show('result');
			generated = true;
		};

		const LOADING_LINES = [
			'Cruzando tu fecha de salida…',
			'Repartiendo el saldo mes a mes…',
			'Ajustando tus fechas de pago…',
		];

		form.addEventListener('submit', (e) => {
			e.preventDefault();
			if (generate.disabled) return;
			clearTimers();
			generate.disabled = true;
			show('loading');

			const wait = reduce ? 250 : 2100;
			if (!reduce) {
				let n = 0;
				loadingSub.textContent = LOADING_LINES[0];
				const tick = () => {
					n = (n + 1) % LOADING_LINES.length;
					loadingSub.textContent = LOADING_LINES[n];
					timers.push(window.setTimeout(tick, 700));
				};
				timers.push(window.setTimeout(tick, 700));
			} else {
				loadingSub.textContent = '';
			}

			// En pantallas apiladas el resultado queda debajo del formulario: se lleva a la vista.
			if (window.matchMedia('(max-width: 1279px)').matches) {
				result.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
			}

			timers.push(
				window.setTimeout(() => {
					clearTimers();
					generate.disabled = false;
					sync();
					renderResult();
				}, wait)
			);
		});

		show('idle');
		sync(false);
	}
</script>

