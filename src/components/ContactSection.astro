---
import { Picture } from 'astro:assets';
import bannerForm from '../assets/contact/bannerform.jpg';

// Key pública de Web3Forms (se define en .env; ver .env.example).
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
---

<section id="contacto" aria-labelledby="contacto-title">
	<div class="contact-media">
		<Picture
			src={bannerForm}
			alt=""
			widths={[640, 960, 1280, 1600, 1920, 2560]}
			sizes="100vw"
			formats={['avif', 'webp']}
			fallbackFormat="jpg"
			width={2560}
			quality={68}
			loading="lazy"
			decoding="async"
		/>
		<div class="contact-overlay"></div>
	</div>

	<div class="contact-inner">
		<div class="contact-copy">
			<p class="eyebrow">CONTACTO</p>
			<h2 id="contacto-title">Tu viaje a China empieza aquí</h2>
			<p class="lead">
				Déjanos tus datos y un asesor de viajes te ayudará a elegir tu itinerario y tu fecha de
				salida.
			</p>
		</div>

		<div class="contact-panel">

			<!-- Al pegar un código de inserción nuevo: cambia src= por data-src= en el <iframe> (así no se descarga con la página) -->
			<iframe
    data-src="https://links.somosescala.co/widget/form/OIX9e9bTWKjsl5M6KLex"
    style="width:100%;height:100%;border:none;border-radius:8px"
    id="inline-OIX9e9bTWKjsl5M6KLex"
    data-layout="{'id':'INLINE'}"
    data-trigger-type="alwaysShow"
    data-trigger-value=""
    data-activation-type="alwaysActivated"
    data-activation-value=""
    data-deactivation-type="neverDeactivate"
    data-deactivation-value=""
    data-form-name="PAGINA WEB"
    data-height="764"
    data-layout-iframe-id="inline-OIX9e9bTWKjsl5M6KLex"
    data-form-id="OIX9e9bTWKjsl5M6KLex"
    data-cookie-consent="true"
    data-cookie-consent-provider="auto"
    title="Formulario de contacto de Ala Libre"
    loading="lazy"
    hidden
        >
</iframe>
<!-- El script del formulario se carga más abajo, solo cuando el usuario se acerca a esta sección -->

				<!-- Formulario propio (Web3Forms, sin cookies de terceros): se muestra mientras el visitante no haya aceptado cookies.
				     Funciona también sin JavaScript (envío normal del formulario). -->
				<div class="own-form-card" id="own-form-card">
					<form id="own-form" action="https://api.web3forms.com/submit" method="POST">
						<input type="hidden" name="access_key" value={web3formsKey} />
						<input type="hidden" name="subject" value="Nuevo contacto desde la landing de China" />
						<input type="hidden" name="from_name" value="Ala Libre - Landing China" />
						<input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" autocomplete="off" />

						<div class="field">
							<label for="of-nombre">Nombre:</label>
							<input id="of-nombre" name="nombre" type="text" autocomplete="given-name" />
						</div>

						<div class="field">
							<label for="of-apellidos">Apellidos:</label>
							<input id="of-apellidos" name="apellidos" type="text" autocomplete="family-name" />
						</div>

						<div class="field">
							<label for="of-telefono">Teléfono *</label>
							<input
								id="of-telefono"
								name="telefono"
								type="tel"
								inputmode="tel"
								autocomplete="tel"
								placeholder="(555) 000-0000"
								required
							/>
						</div>

						<div class="field">
							<label for="of-email">Correo: *</label>
							<div class="with-icon">
								<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
									<rect x="3" y="5" width="18" height="14" rx="2.5"></rect>
									<path d="m4 7.5 8 6 8-6"></path>
								</svg>
								<input
									id="of-email"
									name="email"
									type="email"
									autocomplete="email"
									placeholder="ejemplo@gmail.com"
									required
								/>
							</div>
						</div>

						<div class="field">
							<label for="of-mensaje">Descripción:</label>
							<textarea id="of-mensaje" name="message" rows="4" placeholder="Japón 14 días y 13 noches"></textarea>
						</div>

						<label class="terms">
							<input type="checkbox" name="acepto_terminos" required />
							<span><a href="/terminos-y-condiciones" target="_blank" rel="noopener">Términos y Condiciones</a></span>
						</label>

						<button type="submit" class="own-submit">Enviar</button>

						<p class="own-status" id="own-form-status" role="status" aria-live="polite"></p>

						<p class="own-legal">
							<a href="/politica-de-privacidad" target="_blank" rel="noopener">Política de privacidad</a>
							<span aria-hidden="true">|</span>
							<a href="/terminos-y-condiciones" target="_blank" rel="noopener">Términos del servicio</a>
						</p>
					</form>
				</div>

		</div>
	</div>
</section>

<script>
	// Si cambias el código de inserción del formulario, actualiza esta URL con la del <script> nuevo.
	const FORM_SCRIPT = 'https://links.somosescala.co/js/form_embed.js';

	// El formulario es de un tercero (instala cookies y descarga ~1 MB de scripts). Solo se carga cuando
	// el usuario ya interactuó con la página (scroll, toque o tecla) Y está cerca de esta sección.
	// Orden importante: primero el script del formulario y, cuando termina, se le da su src al iframe;
	// así el script ya está listo para recibir los mensajes del formulario.
	// El formulario es de un proveedor externo (GoHighLevel) e instala sus propias cookies:
	// solo se carga si el visitante ya aceptó cookies analíticas/publicitarias en el banner.
	// Mientras tanto (o si rechaza las cookies) se muestra el formulario propio, que usa Web3Forms y no instala cookies.
	const CONSENT_KEY = 'al-cookie-consent';
	const readConsent = (): { analytics: boolean } | null => {
		try {
			const raw = localStorage.getItem(CONSENT_KEY);
			return raw ? JSON.parse(raw) : null;
		} catch {
			return null;
		}
	};

	const contact = document.getElementById('contacto');
	const frame = contact?.querySelector<HTMLIFrameElement>('iframe');
	const ownCard = document.getElementById('own-form-card');

	if (contact && frame) {
		const formSrc = frame.dataset.src ?? frame.getAttribute('src') ?? '';
		let near = false;
		let interacted = window.scrollY > 0;
		let done = false;

		const load = () => {
			if (done || !near || !interacted || !formSrc) return;
			if (!readConsent()?.analytics) return;
			done = true;
			const script = document.createElement('script');
			script.src = FORM_SCRIPT;
			script.async = true;
			// Si el script no carga, el formulario se muestra de todos modos (funciona sin el ajuste de altura).
			script.onload = script.onerror = () => {
				if (frame.getAttribute('src')) return;
				frame.hidden = false;
				frame.src = formSrc;
				ownCard?.setAttribute('hidden', '');
			};
			document.body.append(script);
		};

		// El banner principal (u otra pestaña) también puede cambiar el consentimiento.
		document.addEventListener('al-consent-change', ((e: CustomEvent<{ analytics: boolean }>) => {
			if (e.detail?.analytics) load();
		}) as EventListener);

		new IntersectionObserver(
			(entries) => {
				near = entries.some((e) => e.isIntersecting);
				load();
			},
			{ rootMargin: '1400px 0px' }
		).observe(contact);

		for (const type of ['scroll', 'wheel', 'touchstart', 'pointerdown', 'keydown']) {
			window.addEventListener(
				type,
				() => {
					interacted = true;
					load();
				},
				{ once: true, passive: true }
			);
		}
	}

	// ---------- Formulario propio (Web3Forms) ----------
	const ownForm = document.getElementById('own-form') as HTMLFormElement | null;
	const ownStatus = document.getElementById('own-form-status');
	const WHATSAPP =
		'https://api.whatsapp.com/send/?phone=522211201356&text=Hola%2C+quiero+viajar+con+Ala+Libre%2C+quiero+comenzar+ahora&type=phone_number&app_absent=0';

	const setStatus = (state: 'ok' | 'error', html: string) => {
		if (!ownStatus) return;
		ownStatus.dataset.state = state;
		ownStatus.innerHTML = html;
	};

	ownForm?.addEventListener('submit', async (e) => {
		e.preventDefault();
		const btn = ownForm.querySelector<HTMLButtonElement>('.own-submit');
		const data = new FormData(ownForm);
		const fullName = [data.get('nombre'), data.get('apellidos')]
			.map((v) => String(v ?? '').trim())
			.filter(Boolean)
			.join(' ');
		if (fullName) data.set('name', fullName);
		data.delete('acepto_terminos');

		if (btn) {
			btn.disabled = true;
			btn.textContent = 'Enviando…';
		}
		if (ownStatus) ownStatus.textContent = '';

		try {
			const res = await fetch(ownForm.action, {
				method: 'POST',
				headers: { Accept: 'application/json' },
				body: data,
			});
			const json = await res.json();
			if (!res.ok || !json.success) throw new Error(json.message ?? 'Error al enviar');
			ownForm.reset();
			setStatus('ok', '¡Gracias! Recibimos tus datos y un asesor te contactará muy pronto.');
		} catch {
			setStatus('error', `No pudimos enviar el formulario. Inténtalo de nuevo o escríbenos por <a href="${WHATSAPP}">WhatsApp</a>.`);
		} finally {
			if (btn) {
				btn.disabled = false;
				btn.textContent = 'Enviar';
			}
		}
	});
</script>

<style>
	#contacto {
		--gold: #d9b26a;
		position: relative;
		min-height: 100vh;
		background-color: var(--alalibre-navy);
		overflow: hidden;
		font-family: var(--font-sans);
	}

	/* ---------- Foto de fondo ---------- */
	.contact-media {
		position: absolute;
		inset: 0;
		background-color: #12122f;
	}

	.contact-media :global(picture),
	.contact-media :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		/* La pagoda queda a la izquierda; el cielo, arriba, para el título */
		object-position: 22% 32%;
	}

	/* Une la foto con las secciones de arriba y de abajo, y oscurece el cielo donde va el título */
	.contact-overlay {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(ellipse 60% 42% at 22% 16%, rgba(0, 0, 46, 0.6), rgba(0, 0, 46, 0) 100%),
			linear-gradient(
				180deg,
				rgba(0, 0, 46, 0.85) 0%,
				rgba(0, 0, 46, 0.1) 22%,
				rgba(0, 0, 46, 0) 70%,
				rgba(0, 0, 46, 0.85) 100%
			);
	}

	/* ---------- Composición: título a la izquierda, formulario a la derecha ---------- */
	.contact-inner {
		position: relative;
		z-index: 2;
		display: grid;
		grid-template-columns: minmax(0, 1fr) clamp(520px, 46vw, 660px);
		align-items: center;
		column-gap: clamp(32px, 5vw, 96px);
		width: 100%;
		min-height: 100vh;
		/* Laterales de 88px como mínimo (sellos fijos de las esquinas) y 96px arriba (barra del menú) */
		padding: 96px max(6vw, 88px) 48px;
		box-sizing: border-box;
	}

	.contact-copy {
		align-self: start;
		max-width: 620px;
		text-shadow: 0 2px 24px rgba(0, 0, 30, 0.55);
	}

	.eyebrow {
		margin: 0 0 12px;
		color: var(--gold);
		font-weight: 700;
		font-size: 14px;
		letter-spacing: 0.32em;
		text-transform: uppercase;
	}

	.contact-copy h2 {
		margin: 0 0 20px;
		color: #ffffff;
		font-weight: 800;
		font-size: clamp(32px, 3.3vw, 64px);
		line-height: 1.02;
		letter-spacing: -0.01em;
		text-transform: uppercase;
		text-wrap: balance;
	}

	.lead {
		margin: 0;
		max-width: 44ch;
		color: rgba(255, 255, 255, 0.92);
		font-weight: 500;
		font-size: clamp(16px, 1.3vw, 22px);
		line-height: 1.55;
	}

	/* Marco de cristal: el formulario "flota" sobre la foto y comparte sus colores */
	.contact-panel {
		position: relative;
		width: 100%;
		min-height: 784px;
		padding: 10px;
		box-sizing: border-box;
		border-radius: 34px;
		background: rgba(255, 255, 255, 0.16);
		box-shadow: 0 24px 70px rgba(0, 0, 30, 0.4);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
	}

	/* ---------- Formulario propio (sin cookies de terceros) ---------- */
	.own-form-card {
		min-height: 764px;
		padding: 20px 20px 22px;
		box-sizing: border-box;
		color: #374151;
		background: #ffffff;
		border-radius: 26px;
		font-family: var(--font-sans);
	}

	.own-form-card[hidden] {
		display: none;
	}

	.own-form-card form {
		display: flex;
		flex-direction: column;
		gap: 18px;
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.field label {
		font-size: 15px;
		font-weight: 600;
		color: #374151;
	}

	.field input,
	.field textarea {
		width: 100%;
		box-sizing: border-box;
		padding: 9px 12px;
		color: #111827;
		background: #ffffff;
		border: 1px solid #cbd5e1;
		border-radius: 8px;
		font: inherit;
		font-size: 15px;
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.field input {
		height: 38px;
	}

	.field textarea {
		min-height: 96px;
		resize: vertical;
	}

	.field ::placeholder {
		color: #6b7280;
	}

	.field input:focus,
	.field textarea:focus {
		outline: none;
		border-color: #155eef;
		box-shadow: 0 0 0 3px rgba(21, 94, 239, 0.18);
	}

	.with-icon {
		position: relative;
	}

	.with-icon svg {
		position: absolute;
		top: 50%;
		left: 12px;
		color: #4b5563;
		transform: translateY(-50%);
		pointer-events: none;
	}

	.with-icon input {
		padding-left: 38px;
	}

	.terms {
		display: flex;
		align-items: center;
		gap: 16px;
		margin-top: 2px;
		font-size: 15px;
		font-weight: 700;
	}

	.terms input {
		flex: none;
		width: 18px;
		height: 18px;
		margin: 0;
		accent-color: #155eef;
	}

	.terms a {
		color: #111827;
		text-decoration: none;
	}

	.terms a:hover {
		text-decoration: underline;
	}

	.own-submit {
		height: 40px;
		margin-top: 6px;
		color: #ffffff;
		background: #155eef;
		border: 0;
		border-radius: 8px;
		font: inherit;
		font-size: 15px;
		font-weight: 700;
		cursor: pointer;
		transition: background 0.2s ease;
	}

	.own-submit:hover:not(:disabled) {
		background: #0f4fd0;
	}

	.own-submit:focus-visible {
		outline: 3px solid rgba(21, 94, 239, 0.4);
		outline-offset: 2px;
	}

	.own-submit:disabled {
		opacity: 0.7;
		cursor: progress;
	}

	.own-status {
		margin: 0;
		font-size: 14px;
		line-height: 1.5;
		text-align: center;
	}

	.own-status:empty {
		display: none;
	}

	.own-status[data-state='ok'] {
		color: #047857;
	}

	.own-status[data-state='error'] {
		color: #b91c1c;
	}

	.own-status a {
		color: inherit;
		font-weight: 700;
	}

	.own-legal {
		display: flex;
		justify-content: center;
		gap: 6px;
		margin: 4px 0 0;
		font-size: 13px;
		color: #4b5563;
	}

	.own-legal a {
		color: #155eef;
	}

	/* Campo trampa para bots (Web3Forms lo descarta si viene marcado) */
	.botcheck {
		position: absolute;
		left: -9999px;
		width: 1px;
		height: 1px;
		opacity: 0;
	}

	.contact-panel iframe[hidden] {
		display: none;
	}

	.contact-panel iframe {
		display: block;
		width: 100%;
		min-height: 764px;
		border: none;
		border-radius: 26px;
	}

	/* En pantallas de escritorio el formulario (~780 px de alto) se reduce según el alto de la ventana,
	   para que se vea completo sin tener que desplazarse. */
	@media (min-width: 1101px) {
		.contact-panel {
			zoom: 0.78;
		}
	}

	@media (min-width: 1101px) and (min-height: 760px) {
		.contact-panel {
			zoom: 0.84;
		}
	}

	@media (min-width: 1101px) and (min-height: 860px) {
		.contact-panel {
			zoom: 0.9;
		}
	}

	/* ---------- Tablet y móvil: la foto es un banner arriba y el formulario lo cruza ---------- */
	@media (max-width: 1100px) {
		#contacto {
			min-height: auto;
		}

		.contact-media {
			bottom: auto;
			height: 560px;
		}

		.contact-media :global(picture),
		.contact-media :global(img) {
			object-position: 24% 60%;
		}

		.contact-overlay {
			background:
				radial-gradient(ellipse 90% 50% at 30% 14%, rgba(0, 0, 46, 0.6), rgba(0, 0, 46, 0) 100%),
				linear-gradient(
					180deg,
					rgba(0, 0, 46, 0.8) 0%,
					rgba(0, 0, 46, 0.15) 26%,
					rgba(0, 0, 46, 0.25) 60%,
					var(--alalibre-navy) 100%
				);
		}

		.contact-inner {
			grid-template-columns: minmax(0, 1fr);
			row-gap: 120px;
			justify-items: center;
			min-height: auto;
			padding: 88px 5vw 64px;
		}

		.contact-copy {
			align-self: auto;
			width: min(100%, 680px);
		}

		.contact-panel {
			width: min(100%, 680px);
		}
	}

	@media (max-width: 700px) {
		.contact-media {
			height: 500px;
		}

		.contact-inner {
			row-gap: 128px;
			padding: 84px 14px 48px;
		}

		.contact-copy {
			padding: 0 6px;
		}

		.contact-copy h2 {
			font-size: clamp(32px, 9.4vw, 44px);
		}

		.contact-panel {
			border-radius: 28px;
		}

		.contact-panel iframe {
			border-radius: 20px;
		}
	}

	@media (max-width: 480px) {
		.contact-inner {
			padding: 84px 8px 40px;
		}

		.contact-panel {
			padding: 8px;
			border-radius: 24px;
		}

		.contact-panel iframe {
			border-radius: 18px;
		}
	}
</style>
