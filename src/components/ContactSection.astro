---
---

<section id="contacto">
	<div class="contact-media" style="background-image: url('/montadragon-desktop.webp')">
		<div class="contact-overlay"></div>
	</div>

	<div class="contact-inner">
		<div class="contact-panel">
			<div class="contact-intro">
				<h2>¡ABRE TUS ALAS!</h2>
				<p>
					Completa el siguiente formulario y un diseñador de viajes te compartirá el itinerario
					completo.
				</p>
			</div>

			<form id="contact-form" class="contact-form">
				<input type="hidden" name="access_key" value="7809a023-af6b-4dd7-88da-029b9309dc75" />
				<input type="hidden" name="subject" value="Nueva solicitud de viaje - Ala Libre" />
				<input type="hidden" name="from_name" value="Formulario Ala Libre China" />

				<label>
					<span>NOMBRE:</span>
					<input type="text" name="nombre" required />
				</label>

				<label>
					<span>CORREO:</span>
					<input type="email" name="correo" required />
				</label>

				<label>
					<span>WHATSAPP:</span>
					<input type="tel" name="whatsapp" required />
				</label>

				<label>
					<span>DESTINO Y DETALLES DEL VIAJE:</span>
					<textarea
						name="detalles"
						rows="2"
						placeholder="Quiero ir a China en noviembre, mi presupuesto es de..."
					></textarea>
				</label>

				<button type="submit" class="btn-outline">Enviar</button>
				<p id="contact-form-status" class="contact-form-status"></p>
			</form>
		</div>
	</div>
</section>

<script>
	const form = document.getElementById('contact-form') as HTMLFormElement | null;
	const status = document.getElementById('contact-form-status');

	form?.addEventListener('submit', async (e) => {
		e.preventDefault();

		const data = new FormData(form);
		const nombre = String(data.get('nombre') || '');
		const correo = String(data.get('correo') || '');
		const whatsapp = String(data.get('whatsapp') || '');
		const detalles = String(data.get('detalles') || '');

		const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
		if (submitBtn) submitBtn.disabled = true;
		if (status) status.textContent = 'Enviando...';

		const waText = encodeURIComponent(
			`Hola, quiero viajar con Ala Libre.\nNombre: ${nombre}\nCorreo: ${correo}\nWhatsApp: ${whatsapp}\nDetalles: ${detalles}`
		);

		try {
			const res = await fetch('https://api.web3forms.com/submit', {
				method: 'POST',
				headers: { Accept: 'application/json' },
				body: data,
			});

			const result = await res.json();
			if (!res.ok || !result.success) throw new Error('request failed');

			window.open(`https://api.whatsapp.com/send/?phone=522211201356&text=${waText}&type=phone_number&app_absent=0`, '_blank');

			if (status) status.textContent = '¡Gracias! Te contactaremos pronto.';
			form.reset();
		} catch (err) {
			if (status) status.textContent = 'Hubo un error al enviar, intenta de nuevo.';
		} finally {
			if (submitBtn) submitBtn.disabled = false;
		}
	});
</script>

<style>
	#contacto {
		position: relative;
		background-color: #00002e;
		overflow: hidden;
		font-family: 'League Spartan', sans-serif;
	}

	.contact-media {
		position: absolute;
		inset: 0;
		background-size: cover;
		background-position: center;
		background-color: #12122f;
	}

	.contact-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			180deg,
			rgba(0, 0, 46, 0.75) 0%,
			rgba(0, 0, 46, 0) 20%,
			rgba(0, 0, 46, 0) 78%,
			rgba(0, 0, 46, 0.8) 100%
		);
	}

	.contact-inner {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: center;
		max-width: 760px;
		margin: 0 0 0 auto;
		padding: 90px 6vw;
		min-height: 100vh;
		box-sizing: border-box;
		justify-content: center;
	}

	.contact-panel {
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: 28px;
		background: rgba(0, 0, 0, 0.5);
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 18px;
		padding: 36px;
		box-sizing: border-box;
	}

	.contact-intro {
		flex: none;
		text-align: center;
	}

	.contact-intro h2 {
		margin: 0 0 16px;
		color: #ffffff;
		font-weight: 800;
		font-size: clamp(30px, 4.2vw, 44px);
	}

	.contact-intro p {
		margin: 0 auto;
		color: rgba(255, 255, 255, 0.9);
		font-size: 17px;
		line-height: 1.6;
		max-width: 380px;
	}

	.contact-form {
		flex: none;
		width: 100%;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 20px 24px;
	}

	.contact-form label {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.contact-form label:nth-of-type(3),
	.contact-form label:nth-of-type(4) {
		grid-column: 1 / -1;
	}

	.contact-form span {
		color: #ffffff;
		font-weight: 700;
		font-size: 15px;
		letter-spacing: 0.06em;
	}

	.contact-form input,
	.contact-form textarea {
		background: rgba(0, 0, 0, 0.55);
		border: 1px solid rgba(255, 255, 255, 0.15);
		border-radius: 8px;
		color: #ffffff;
		font-family: 'League Spartan', sans-serif;
		font-size: 17px;
		padding: 14px 16px;
		resize: none;
	}

	.contact-form input::placeholder,
	.contact-form textarea::placeholder {
		color: rgba(255, 255, 255, 0.55);
	}

	.contact-form input:focus,
	.contact-form textarea:focus {
		outline: none;
		border-color: rgba(255, 255, 255, 0.6);
	}

	.contact-form .btn-outline {
		grid-column: 1 / -1;
		justify-self: center;
		margin-top: 8px;
		color: #ffffff;
		font-family: 'League Spartan', sans-serif;
		font-weight: 500;
		font-size: 17px;
		padding: 14px 32px;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.14);
		border: 1px solid rgba(255, 255, 255, 0.5);
		cursor: pointer;
		transition:
			background 0.2s ease,
			border-color 0.2s ease;
	}

	.contact-form .btn-outline:hover {
		background: rgba(255, 255, 255, 0.28);
		border-color: #ffffff;
	}

	.contact-form .btn-outline:disabled {
		opacity: 0.6;
		cursor: default;
	}

	.contact-form-status {
		grid-column: 1 / -1;
		margin: 0;
		text-align: center;
		color: #ffffff;
		font-size: 13px;
		min-height: 1em;
	}

	@media (max-width: 700px) {
		.contact-media {
			background-image: url('/montadragon-mobile.webp') !important;
		}

		.contact-inner {
			padding: 64px 6vw;
		}

		.contact-panel {
			padding: 24px;
		}

		.contact-form {
			grid-template-columns: 1fr;
		}

		.contact-form label:nth-of-type(3),
		.contact-form label:nth-of-type(4) {
			grid-column: auto;
		}
	}
</style>
