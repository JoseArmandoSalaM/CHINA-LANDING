---
import { Picture } from 'astro:assets';
import bannerForm from '../assets/contact/bannerform.jpg';
---

<section id="contacto" aria-labelledby="contacto-title">
	<div class="contact-media">
		<Picture
			src={bannerForm}
			alt=""
			widths={[640, 960, 1280, 1600, 1920, 2560]}
			sizes="100vw"
			formats={['avif', 'webp']}
			fallbackFormat="jpg"
			width={2560}
			quality={68}
			loading="lazy"
			decoding="async"
		/>
		<div class="contact-overlay"></div>
	</div>

	<div class="contact-inner">
		<div class="contact-copy">
			<p class="eyebrow">CONTACTO</p>
			<h2 id="contacto-title">Tu viaje a China empieza aquí</h2>
			<p class="lead">
				Déjanos tus datos y un diseñador de viajes te ayudará a elegir tu itinerario y tu fecha de
				salida.
			</p>
		</div>

		<div class="contact-panel">

			<!-- Al pegar un código de inserción nuevo: cambia src= por data-src= en el <iframe> (así no se descarga con la página) -->
			<iframe
    data-src="https://links.somosescala.co/widget/form/OIX9e9bTWKjsl5M6KLex"
    style="width:100%;height:100%;border:none;border-radius:8px"
    id="inline-OIX9e9bTWKjsl5M6KLex"
    data-layout="{'id':'INLINE'}"
    data-trigger-type="alwaysShow"
    data-trigger-value=""
    data-activation-type="alwaysActivated"
    data-activation-value=""
    data-deactivation-type="neverDeactivate"
    data-deactivation-value=""
    data-form-name="PAGINA WEB"
    data-height="764"
    data-layout-iframe-id="inline-OIX9e9bTWKjsl5M6KLex"
    data-form-id="OIX9e9bTWKjsl5M6KLex"
    data-cookie-consent="true"
    data-cookie-consent-provider="auto"
    title="Formulario de contacto de Ala Libre"
    loading="lazy"
        >
</iframe>
<!-- El script del formulario se carga más abajo, solo cuando el usuario se acerca a esta sección -->
			<noscript>
				<p class="nojs">
					Activa JavaScript para ver el formulario o escríbenos por
					<a href="https://api.whatsapp.com/send/?phone=522211201356&text=Hola%2C+quiero+viajar+con+Ala+Libre%2C+quiero+comenzar+ahora&type=phone_number&app_absent=0">WhatsApp</a>.
				</p>
			</noscript>

			<div class="consent-gate" id="contact-consent-gate" hidden>
				<p class="nojs">
					Este formulario lo provee un tercero y usa cookies propias de su servicio. Acepta las
					cookies analíticas y de publicidad para verlo aquí, o escríbenos directo por
					<a href="https://api.whatsapp.com/send/?phone=522211201356&text=Hola%2C+quiero+viajar+con+Ala+Libre%2C+quiero+comenzar+ahora&type=phone_number&app_absent=0">WhatsApp</a>.
				</p>
				<button type="button" id="contact-consent-accept" class="consent-gate-btn">
					Aceptar y cargar formulario
				</button>
			</div>

		</div>
	</div>
</section>

<script>
	// Si cambias el código de inserción del formulario, actualiza esta URL con la del <script> nuevo.
	const FORM_SCRIPT = 'https://links.somosescala.co/js/form_embed.js';

	// El formulario es de un tercero (instala cookies y descarga ~1 MB de scripts). Solo se carga cuando
	// el usuario ya interactuó con la página (scroll, toque o tecla) Y está cerca de esta sección.
	// Orden importante: primero el script del formulario y, cuando termina, se le da su src al iframe;
	// así el script ya está listo para recibir los mensajes del formulario.
	// El formulario es de un proveedor externo (GoHighLevel) e instala sus propias cookies:
	// solo se carga si el visitante ya aceptó cookies analíticas/publicitarias en el banner.
	const CONSENT_KEY = 'al-cookie-consent';
	const readConsent = (): { analytics: boolean } | null => {
		try {
			const raw = localStorage.getItem(CONSENT_KEY);
			return raw ? JSON.parse(raw) : null;
		} catch {
			return null;
		}
	};

	const contact = document.getElementById('contacto');
	const frame = contact?.querySelector<HTMLIFrameElement>('iframe');
	const gate = document.getElementById('contact-consent-gate');

	if (contact && frame) {
		const formSrc = frame.dataset.src ?? frame.getAttribute('src') ?? '';
		let near = false;
		let interacted = window.scrollY > 0;
		let done = false;

		const load = () => {
			if (done || !near || !interacted || !formSrc) return;
			if (!readConsent()?.analytics) {
				gate?.removeAttribute('hidden');
				return;
			}
			gate?.setAttribute('hidden', '');
			done = true;
			const script = document.createElement('script');
			script.src = FORM_SCRIPT;
			script.async = true;
			// Si el script no carga, el formulario se muestra de todos modos (funciona sin el ajuste de altura).
			script.onload = script.onerror = () => {
				if (!frame.getAttribute('src')) frame.src = formSrc;
			};
			document.body.append(script);
		};

		document.getElementById('contact-consent-accept')?.addEventListener('click', () => {
			try {
				localStorage.setItem(CONSENT_KEY, JSON.stringify({ analytics: true, ts: Date.now() }));
			} catch {
				/* sin acceso a localStorage: el formulario no se recordará como aceptado en la próxima visita */
			}
			document.dispatchEvent(new CustomEvent('al-consent-change', { detail: { analytics: true } }));
			load();
		});

		// El banner principal (u otra pestaña) también puede cambiar el consentimiento.
		document.addEventListener('al-consent-change', ((e: CustomEvent<{ analytics: boolean }>) => {
			if (e.detail?.analytics) load();
		}) as EventListener);

		new IntersectionObserver(
			(entries) => {
				near = entries.some((e) => e.isIntersecting);
				load();
			},
			{ rootMargin: '1400px 0px' }
		).observe(contact);

		for (const type of ['scroll', 'wheel', 'touchstart', 'pointerdown', 'keydown']) {
			window.addEventListener(
				type,
				() => {
					interacted = true;
					load();
				},
				{ once: true, passive: true }
			);
		}
	}
</script>

<style>
	#contacto {
		--gold: #d9b26a;
		position: relative;
		min-height: 100vh;
		background-color: var(--alalibre-navy);
		overflow: hidden;
		font-family: var(--font-sans);
	}

	/* ---------- Foto de fondo ---------- */
	.contact-media {
		position: absolute;
		inset: 0;
		background-color: #12122f;
	}

	.contact-media :global(picture),
	.contact-media :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		/* La pagoda queda a la izquierda; el cielo, arriba, para el título */
		object-position: 22% 32%;
	}

	/* Une la foto con las secciones de arriba y de abajo, y oscurece el cielo donde va el título */
	.contact-overlay {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(ellipse 60% 42% at 22% 16%, rgba(0, 0, 46, 0.6), rgba(0, 0, 46, 0) 100%),
			linear-gradient(
				180deg,
				rgba(0, 0, 46, 0.85) 0%,
				rgba(0, 0, 46, 0.1) 22%,
				rgba(0, 0, 46, 0) 70%,
				rgba(0, 0, 46, 0.85) 100%
			);
	}

	/* ---------- Composición: título a la izquierda, formulario a la derecha ---------- */
	.contact-inner {
		position: relative;
		z-index: 2;
		display: grid;
		grid-template-columns: minmax(0, 1fr) clamp(520px, 46vw, 660px);
		align-items: center;
		column-gap: clamp(32px, 5vw, 96px);
		width: 100%;
		min-height: 100vh;
		/* Laterales de 88px como mínimo (sellos fijos de las esquinas) y 96px arriba (barra del menú) */
		padding: 96px max(6vw, 88px) 48px;
		box-sizing: border-box;
	}

	.contact-copy {
		align-self: start;
		max-width: 620px;
		text-shadow: 0 2px 24px rgba(0, 0, 30, 0.55);
	}

	.eyebrow {
		margin: 0 0 12px;
		color: var(--gold);
		font-weight: 700;
		font-size: 14px;
		letter-spacing: 0.32em;
		text-transform: uppercase;
	}

	.contact-copy h2 {
		margin: 0 0 20px;
		color: #ffffff;
		font-weight: 800;
		font-size: clamp(32px, 3.3vw, 64px);
		line-height: 1.02;
		letter-spacing: -0.01em;
		text-transform: uppercase;
		text-wrap: balance;
	}

	.lead {
		margin: 0;
		max-width: 44ch;
		color: rgba(255, 255, 255, 0.92);
		font-weight: 500;
		font-size: clamp(16px, 1.3vw, 22px);
		line-height: 1.55;
	}

	/* Marco de cristal: el formulario "flota" sobre la foto y comparte sus colores */
	.contact-panel {
		position: relative;
		width: 100%;
		min-height: 784px;
		padding: 10px;
		box-sizing: border-box;
		border-radius: 34px;
		background: rgba(255, 255, 255, 0.16);
		box-shadow: 0 24px 70px rgba(0, 0, 30, 0.4);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
	}

	/* El marco se ajusta a la altura del formulario (el script del formulario cambia la del iframe) */
	.nojs {
		margin: 0;
		padding: 24px;
		color: #ffffff;
		font-size: 17px;
		line-height: 1.6;
	}

	.nojs a {
		color: var(--gold);
	}

	.consent-gate {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 14px;
		padding: 24px;
	}

	.consent-gate[hidden] {
		display: none;
	}

	.consent-gate-btn {
		padding: 12px 24px;
		color: var(--alalibre-navy);
		background: var(--gold);
		border: 0;
		border-radius: 999px;
		font: inherit;
		font-weight: 700;
		font-size: 14px;
		cursor: pointer;
		transition: background 0.2s ease;
	}

	.consent-gate-btn:hover {
		background: #ecd28f;
	}

	.contact-panel iframe {
		display: block;
		width: 100%;
		min-height: 764px;
		border: none;
		border-radius: 26px;
	}

	/* En pantallas de escritorio el formulario (~780 px de alto) se reduce según el alto de la ventana,
	   para que se vea completo sin tener que desplazarse. */
	@media (min-width: 1101px) {
		.contact-panel {
			zoom: 0.78;
		}
	}

	@media (min-width: 1101px) and (min-height: 760px) {
		.contact-panel {
			zoom: 0.84;
		}
	}

	@media (min-width: 1101px) and (min-height: 860px) {
		.contact-panel {
			zoom: 0.9;
		}
	}

	/* ---------- Tablet y móvil: la foto es un banner arriba y el formulario lo cruza ---------- */
	@media (max-width: 1100px) {
		#contacto {
			min-height: auto;
		}

		.contact-media {
			bottom: auto;
			height: 560px;
		}

		.contact-media :global(picture),
		.contact-media :global(img) {
			object-position: 24% 60%;
		}

		.contact-overlay {
			background:
				radial-gradient(ellipse 90% 50% at 30% 14%, rgba(0, 0, 46, 0.6), rgba(0, 0, 46, 0) 100%),
				linear-gradient(
					180deg,
					rgba(0, 0, 46, 0.8) 0%,
					rgba(0, 0, 46, 0.15) 26%,
					rgba(0, 0, 46, 0.25) 60%,
					var(--alalibre-navy) 100%
				);
		}

		.contact-inner {
			grid-template-columns: minmax(0, 1fr);
			row-gap: 120px;
			justify-items: center;
			min-height: auto;
			padding: 88px 5vw 64px;
		}

		.contact-copy {
			align-self: auto;
			width: min(100%, 680px);
		}

		.contact-panel {
			width: min(100%, 680px);
		}
	}

	@media (max-width: 700px) {
		.contact-media {
			height: 500px;
		}

		.contact-inner {
			row-gap: 128px;
			padding: 84px 14px 48px;
		}

		.contact-copy {
			padding: 0 6px;
		}

		.contact-copy h2 {
			font-size: clamp(32px, 9.4vw, 44px);
		}

		.contact-panel {
			border-radius: 28px;
		}

		.contact-panel iframe {
			border-radius: 20px;
		}
	}

	@media (max-width: 480px) {
		.contact-inner {
			padding: 84px 8px 40px;
		}

		.contact-panel {
			padding: 8px;
			border-radius: 24px;
		}

		.contact-panel iframe {
			border-radius: 18px;
		}
	}
</style>
