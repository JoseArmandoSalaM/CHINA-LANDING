<section id="contacto">
	<div
		class="contact-media"
		style="background-image: url('/montadragon-desktop.webp')"
	>
		<div class="contact-overlay"></div>
	</div>

	<div class="contact-inner">
		<div class="contact-panel">
		<iframe
    src="https://api.ikigai.com.ec/widget/form/GV4BI0LfXJmcXWOm8jvx"
    style="width:100%;height:100%;border:none;border-radius:30px"
    id="inline-GV4BI0LfXJmcXWOm8jvx" 
    data-layout="{'id':'INLINE'}"
    data-trigger-type="alwaysShow"
    data-trigger-value=""
    data-activation-type="alwaysActivated"
    data-activation-value=""
    data-deactivation-type="neverDeactivate"
    data-deactivation-value=""
    data-form-name="Form Web Contacto"
    data-height="763"
    data-layout-iframe-id="inline-GV4BI0LfXJmcXWOm8jvx"
    data-form-id="GV4BI0LfXJmcXWOm8jvx"
    title="Form Web Contacto"
    
        >
</iframe>
<script src="https://api.ikigai.com.ec/js/form_embed.js"></script>
		</div>
	</div>
</section>

<script
	src="https://api.ikigai.com.ec/js/form_embed.js"
	is:inline
></script>

<style>
	#contacto {
		position: relative;
		min-height: 100vh;
		background-color: #00002e;
		overflow: hidden;
		font-family: 'League Spartan', sans-serif;
	}

	.contact-media {
		position: absolute;
		inset: 0;
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
		background-color: #12122f;
	}

	.contact-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			180deg,
			rgba(0, 0, 46, 0.75) 0%,
			rgba(0, 0, 46, 0) 20%,
			rgba(0, 0, 46, 0) 78%,
			rgba(0, 0, 46, 0.8) 100%
		);
	}

	.contact-inner {
		position: relative;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: flex-end;
		width: 100%;
		min-height: 100vh;
		padding: 70px 6vw;
		box-sizing: border-box;
	}

	.contact-panel {
		width: min(100%, 680px);
		height: 761px;
		border-radius: 30px;
		overflow: hidden;
	}

	.contact-panel iframe {
		display: block;
		width: 100%;
		height: 100%;
		border: none;
		border-radius: 30px;
	}

	@media (max-width: 900px) {
		.contact-inner {
			justify-content: center;
			padding: 60px 5vw;
		}

		.contact-panel {
			width: min(100%, 680px);
		}
	}

	@media (max-width: 700px) {
		.contact-media {
			background-image: url('/montadragon-mobile.webp') !important;
		}

		.contact-inner {
			min-height: auto;
			padding: 40px 14px;
		}

		.contact-panel {
			width: 100%;
			height: 820px;
			border-radius: 22px;
		}

		.contact-panel iframe {
			border-radius: 22px;
		}
	}

	@media (max-width: 480px) {
		.contact-inner {
			padding: 25px 8px;
		}

		.contact-panel {
			height: 880px;
			border-radius: 18px;
		}

		.contact-panel iframe {
			border-radius: 18px;
		}
	}
</style>